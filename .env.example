# ==============================================================================
# Automated Open-Source PR Chronicler and Learning Dispatcher - Environment Configuration
# ==============================================================================

# 1. Google Gemini API Configuration
# Get an API key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key
# Model identifier supported by langchain-google-genai (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. GitHub REST API Configuration
# Personal Access Token (classic or fine-grained) with public_repo read access.
# Required for higher rate limits (5,000 req/hr vs 60 req/hr unauthenticated).
GITHUB_TOKEN=your_github_personal_access_token

# Optional GitHub Webhook Secret for HMAC SHA-256 signature verification (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# 3. SMTP Email Dispatcher Configuration
# Host and port depend on your email provider (e.g. smtp.gmail.com:587 for TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
# Use an App Password (not your personal account password)
SMTP_APP_PASSWORD=your_smtp_app_password
# Optional recipient email address; defaults to SMTP_EMAIL if omitted
RECIPIENT_EMAIL=your_email@gmail.com

# 4. Service Configuration
PORT=8000
HOST=0.0.0.0
